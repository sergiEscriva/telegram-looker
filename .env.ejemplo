# Credenciales de https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# (Opcional) Canal por defecto: @usuario, enlace t.me/..., enlace de invitación o ID numérico.
# Si lo dejas vacío, el script te mostrará un menú para elegir.
CANAL=

# (Opcional) Carpeta de destino y número de descargas simultáneas por cuenta
# CARPETA_DESTINO=D:\Telegram
HILOS=3

# (Opcional) Varias cuentas: cuáles usar (vacío = todas las de ./sesiones) y cómo repartir
#   canal    -> cada cuenta descarga canales distintos
#   mensajes -> todas las cuentas se reparten los mensajes de cada canal
CUENTAS=
REPARTO=canal

# (Opcional) Trozos que se piden a la vez de cada archivo grande (1-8)
CONEXIONES=4

# (Opcional) Cifrar las sesiones con una contraseña (se pide al arrancar): si / no
CIFRAR_SESIONES=no

# (Opcional) Puerto del panel web
PUERTO_PANEL=8765

# (Opcional) Cómo aparece esta sesión en Telegram > Ajustes > Dispositivos
#   NOMBRE_DISPOSITIVO -> modelo del dispositivo (por defecto "PC")
#   SISTEMA_DISPOSITIVO -> sistema operativo (vacío = el real, p. ej. "10" en Windows 10)
#   VERSION_APP -> versión que se muestra junto al nombre de la app (vacío = versión de Telethon)
# El nombre de la app en sí es el "App title" que pusiste en https://my.telegram.org
NOMBRE_DISPOSITIVO=
SISTEMA_DISPOSITIVO=
VERSION_APP=
