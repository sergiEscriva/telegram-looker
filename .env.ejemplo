# Credenciales de https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# (Opcional) Canal por defecto: @usuario, enlace t.me/..., enlace de invitación o ID numérico.
# Si lo dejas vacío, el script te mostrará un menú para elegir.
CANAL=

# (Opcional) Carpeta de destino y número de descargas simultáneas por cuenta
# CARPETA_DESTINO=D:\Telegram
HILOS=3

# (Opcional) Varias cuentas: cuáles usar (vacío = todas las de ./sesiones) y cómo repartir
#   canal    -> cada cuenta descarga canales distintos
#   mensajes -> todas las cuentas se reparten los mensajes de cada canal
CUENTAS=
REPARTO=canal

# (Opcional) Puerto del panel web
PUERTO_PANEL=8765
